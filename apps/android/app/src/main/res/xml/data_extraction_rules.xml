<?xml version="1.0" encoding="utf-8"?><!--
  Exclude session tokens and composer drafts from cloud backup and device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cerin.secure.xml" />
        <exclude domain="sharedpref" path="cerin.backend.xml" />
        <exclude domain="sharedpref" path="cerin.voice.xml" />
        <exclude domain="sharedpref" path="cerin.secure.fallback.xml" />
        <exclude domain="sharedpref" path="cerin.composer-drafts.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cerin.secure.xml" />
        <exclude domain="sharedpref" path="cerin.backend.xml" />
        <exclude domain="sharedpref" path="cerin.voice.xml" />
        <exclude domain="sharedpref" path="cerin.secure.fallback.xml" />
        <exclude domain="sharedpref" path="cerin.composer-drafts.xml" />
    </device-transfer>
</data-extraction-rules>
