# Copy to .env.e2e.local. All values below are placeholders.
CERIN_E2E_DEVICE_SERIAL=emulator-5556
CERIN_E2E_EXPECTED_EMAIL=tester@example.invalid
CERIN_E2E_TEAM_ID=replace-with-test-team-id
CERIN_E2E_LOGIN_MODE=existing-session
CERIN_E2E_ALLOW_LOGIN=false
# Dedicated clean test devices only: mode=password and ALLOW_LOGIN=true.
# Supply CERIN_E2E_PASSWORD through an environment secret or a 0600 local file.
